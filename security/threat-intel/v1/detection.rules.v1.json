{
  "schema_version": "1.0.0",
  "ruleset_version": "2026.08.0",
  "permission_combination_rules": [
    {
      "id": "perm.sms.overlay.admin",
      "severity": "high",
      "permissions": ["SEND_SMS", "SYSTEM_ALERT_WINDOW", "BIND_DEVICE_ADMIN"],
      "trigger_threshold": 2,
      "rationale": "Overlay + admin + SMS can indicate coercive fraud behavior.",
      "false_positive_notes": "Enterprise MDM agents may legitimately request admin rights."
    },
    {
      "id": "perm.accessibility.notification.exfil",
      "severity": "medium",
      "permissions": ["BIND_ACCESSIBILITY_SERVICE", "BIND_NOTIFICATION_LISTENER_SERVICE", "READ_CONTACTS"],
      "trigger_threshold": 2,
      "rationale": "Accessibility and notification capture can be abused for phishing/exfiltration.",
      "false_positive_notes": "Accessibility-focused apps can trigger this rule."
    }
  ],
  "network_behavior_rules": [
    {
      "id": "net.high_dns_churn",
      "severity": "medium",
      "metric": "unique_domains_per_10m",
      "operator": ">=",
      "threshold": 40,
      "rationale": "High domain churn can indicate domain-generation-algorithm patterns."
    },
    {
      "id": "net.repeated_failed_tls",
      "severity": "high",
      "metric": "failed_tls_handshakes_per_5m",
      "operator": ">=",
      "threshold": 15,
      "rationale": "Repeated TLS failures can indicate probing, downgrade, or interception attempts."
    }
  ],
  "exploit_indicator_rules": [
    {
      "id": "exp.cve-2024-43093",
      "severity": "high",
      "source": "android-security-bulletin",
      "advisory": "CVE-2024-43093",
      "indicator_type": "process_argument",
      "pattern": "--zygote --start-system-server",
      "confidence": 0.8
    },
    {
      "id": "exp.cve-2024-32896",
      "severity": "medium",
      "source": "nvd-cve",
      "advisory": "CVE-2024-32896",
      "indicator_type": "network_ioc",
      "pattern": "known-c2-host.example",
      "confidence": 0.6
    }
  ],
  "tuning": {
    "model_confidence_threshold": 0.7,
    "rule_vote_threshold": 2,
    "low_confidence_fallback": "rule-based-detection"
  }
}

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_sigil_gradient"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/ivSigilBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.10"
        android:contentDescription="@string/cd_sigil_background"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_sigil_circle" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="40dp"
            android:paddingBottom="32dp">

            <TextView
                android:id="@+id/tvWordmark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textAppearance="?attr/textAppearanceDisplaySmall"
                android:textColor="@color/gold"
                android:textStyle="bold"
                tools:text="CoreGuard" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/main_subtitle"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="@color/text_secondary"
                tools:text="Occult wards. Modern defense." />

            <TextView
                android:id="@+id/tvTagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/main_tagline"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/text_tertiary"
                tools:text="Your device, sealed beneath the Sigillum Dei" />

            <TextView
                android:id="@+id/tvPrototypeDisclaimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_disclaimer_pill"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:text="@string/prototype_disclaimer"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/text_primary"
                tools:text="Prototype build: CPU is simulated. Billing path depends on debug vs release." />

            <TextView
                android:id="@+id/tvRestrictedBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_state_chip_fail"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:text="@string/restricted_mode_banner"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/status_fail"
                android:visibility="gone"
                tools:text="RESTRICTED MODE: high-risk security FAIL detected. Sensitive features locked (prototype gate)."
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvEntitlementBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_disclaimer_pill"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:text="@string/entitlement_demo_free"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/text_primary"
                tools:text="Entitlement: Free (demo billing — not a purchase)" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/scoreContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                app:cardBackgroundColor="@color/azure_surface"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/azure_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/guardian_score_title"
                        android:textAppearance="?attr/textAppearanceTitleLarge"
                        android:textColor="@color/gold"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/guardian_score_hint"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/text_secondary"
                        tools:text="Tap the shield for the full ritual of checks" />

                    <com.coldboar.coreguard.GuardianScoreView
                        android:id="@+id/guardianScoreView"
                        android:layout_width="200dp"
                        android:layout_height="200dp"
                        android:layout_marginTop="18dp"
                        android:contentDescription="@string/cd_guardian_shield"
                        tools:score="82" />

                    <TextView
                        android:id="@+id/tvRank"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/rank_warded"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall"
                        android:textColor="@color/ward_teal"
                        android:textStyle="bold"
                        tools:text="WARDED" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/section_vitals"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/azure_surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/azure_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_ram_usage"
                        android:textAllCaps="true"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="@color/text_secondary"
                        android:letterSpacing="0.1" />

                    <TextView
                        android:id="@+id/tvRamUsage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="@color/text_primary"
                        tools:text="3.2 GB / 8.0 GB" />

                    <TextView
                        android:id="@+id/tvRamPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/text_tertiary"
                        tools:text="40%" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/ramProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:indicatorColor="@color/ward_teal"
                        app:trackColor="@color/azure_deep"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="6dp"
                        tools:progress="40" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="18dp"
                        android:background="@color/azure_stroke" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/label_cpu_usage"
                        android:textAllCaps="true"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="@color/text_secondary"
                        android:letterSpacing="0.1" />

                    <TextView
                        android:id="@+id/tvCpuUsage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/cpu_simulated_label"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/text_tertiary"
                        tools:text="SIMULATED — not measured on device" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/cpuProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:indicatorColor="@color/gold"
                        app:trackColor="@color/azure_deep"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="6dp"
                        tools:progress="0" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSecurityDashboard"
                style="@style/Widget.CoreGuard.Button.Gold"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:text="@string/btn_security_dashboard"
                app:icon="@drawable/ic_unicursal_hexagram"
                app:iconGravity="textStart"
                app:iconTint="@color/azure_deep" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNemesisScanner"
                style="@style/Widget.CoreGuard.Button.Gold"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:text="@string/btn_nemesis_scanner"
                app:icon="@drawable/ic_unicursal_hexagram"
                app:iconGravity="textStart"
                app:iconTint="@color/azure_deep" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNetworkDefenseLab"
                style="@style/Widget.CoreGuard.Button.Gold"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:text="@string/btn_network_defense_lab"
                app:icon="@drawable/ic_unicursal_hexagram"
                app:iconGravity="textStart"
                app:iconTint="@color/azure_deep" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUpgradePremium"
                style="@style/Widget.CoreGuard.Button.Ghost"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/btn_upgrade_premium_demo" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>

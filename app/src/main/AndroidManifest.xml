<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Loopback Frida-port probes, optional threat-intel downloads, and
         forwarding of *allowed* Privacy Shield DNS queries to the system /
         upstream resolver (fallback 8.8.8.8). Scan artifacts stay on-device. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Google Play Billing Library for CoreGuard Premium subscriptions. -->
    <uses-permission android:name="com.android.vending.BILLING" />
    <!-- Foreground service hosting the always-on spyware-domain blocker VPN. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Enumerate installed apps to check them against spyware package indicators.
         Declared for Play Console as a core antivirus / device-security feature. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".CoreGuardApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CoreGuard"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Legacy View-system Activities removed from the release surface.
             Compose MainActivity hosts Scanner / Home / Shield / Settings.
             PaywallActivity remains for SubscriptionManager deep-link purchases. -->
        <activity
            android:name=".PaywallActivity"
            android:exported="false" />

        <service
            android:name=".mvt.GuardVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs an on-device privacy VPN that blocks connections to servers known to track or surveil users" />
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

    </application>

</manifest>
